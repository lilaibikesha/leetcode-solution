class Solution(object):
    def reverseVowels(self, s):
        """
        :type s: str
        :rtype: str
        """
        s=list(s)
        vowels = set('aeiouAEIOU')

        def reverse(l,r):
            if l>=r:
                return 
            elif s[l] not in vowels:
                reverse (l+1, r)
            elif s[r] not in vowels:
                reverse (l, r-1) 
            else:
                s[l],s[r] = s[r], s[l]
                reverse (l+1, r-1)
        reverse (0, len(s)-1)
        return "".join(s)
