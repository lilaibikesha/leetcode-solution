class Solution:
    def predictPartyVictory(self, senate: str) -> str:
        senate = list(senate)
        D, R = deque(), deque()
        for i, c in enumerate(senate):
            if c == "R":
                R.append(i)
            else:
                D.append(i)
            
        while D and R:
                DTurn = D.popleft()
                RTurn = R.popleft()
                if RTurn < DTurn:
                    R.append(RTurn + len(senate))
                else: 
                    D.append(DTurn + len(senate))


        return "Radiant" if R else "Dire"
